# Токен API Wildberries (получается в личном кабинете продавца)
WB_API_TOKEN=your_wb_api_token_here

# Настройки сервера
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=False

# Уровень логирования
LOG_LEVEL=INFO

# База данных PostgreSQL
DATABASE_URL=postgresql://bot_user:botpwd@localhost:5432/wb_promotion_app
