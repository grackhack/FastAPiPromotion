[Unit]
Description=FastAPI Wildberries Promotion App
After=network.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/FastAPiPromotion
Environment="PATH=/home/botuser/FastAPiPromotion/.venv/bin"
ExecStart=/home/botuser/FastAPiPromotion/.venv/bin/uvicorn wb_promotion_app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wb-promotion

[Install]
WantedBy=multi-user.target
